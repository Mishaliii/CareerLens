# CareerLens AI Environment Configuration Template
# Copy this file to .env and configure values for your environment.

# ==============================================================================
# 1. Environment & Mode
# ==============================================================================
# Options: development, test, production
ENVIRONMENT=development

# ==============================================================================
# 2. Database Configuration
# ==============================================================================
# Local SQLite (default for development):
# DATABASE_URL=sqlite:///data/careerlens.db
#
# Production PostgreSQL (Neon, Supabase, RDS, etc.):
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<dbname>
# Note: 'postgres://' and 'postgresql://' URLs are automatically normalized to 'postgresql+psycopg2://'
# Note: In production mode, DATABASE_URL is strictly required; falling back to SQLite is disabled.
DATABASE_URL=sqlite:///data/careerlens.db

# Database Connection Pool Settings (PostgreSQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# ==============================================================================
# 3. Authentication & Security
# ==============================================================================
# Cryptographic secret for signing JWT access tokens (minimum 32 characters required in production)
JWT_SECRET_KEY=careerlens-development-secret-key-min-32-bytes-long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=careerlens-auth
JWT_AUDIENCE=careerlens-api

# ==============================================================================
# 4. CORS (Cross-Origin Resource Sharing)
# ==============================================================================
# Comma-separated list of allowed origins.
# Development default: http://localhost:5173,http://localhost:3000
# Production: Strictly required (e.g. https://careerlens.pages.dev,https://careerlens.ai).
# Note: Wildcard '*' is forbidden in production when credentials are enabled.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================================================
# 5. Rate Limiting & Proxy Configuration
# ==============================================================================
# Set to 1 if behind a trusted reverse proxy (e.g. Cloudflare, Render) to trust X-Forwarded-For
BEHIND_TRUSTED_PROXY=0

# Rate limits formatted as count/period (period: second, minute, hour)
RATE_LIMIT_AUTH_REGISTER=5/minute
RATE_LIMIT_AUTH_LOGIN=10/minute
RATE_LIMIT_CV_PROCESS=5/minute
RATE_LIMIT_AGENT_QUERY=20/minute
RATE_LIMIT_JOB_MATCH=15/minute

# Set to 1 to bypass rate limits during automated test runs
CAREERLENS_DISABLE_RATE_LIMIT=0

# ==============================================================================
# 6. Upload & File Protection
# ==============================================================================
# Maximum PDF upload size in bytes (default: 10485760 = 10 MiB)
MAX_UPLOAD_SIZE_BYTES=10485760

# ==============================================================================
# 7. Vector Storage & Embeddings
# ==============================================================================
# Directory for local FAISS index file cache (defaults to data/vector_indexes or /tmp in containers)
VECTOR_INDEX_DIR=data/vector_indexes

# Active SentenceTransformer embedding model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Set to 1 to use deterministic mock embeddings for offline unit tests without model weights
CAREERLENS_USE_MOCK_EMBEDDER=0

# ==============================================================================
# 8. External AI Services
# ==============================================================================
# Google Gemini API Key (obtained from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# 9. Optional External APIs (Post-Beta)
# ==============================================================================
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=
RESEND_API_KEY=
